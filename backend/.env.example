# Backend FastAPI Configuration
# Salin file ini ke `.env` dan isi nilainya.

# ===== Database =====
# Format: postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME
# Contoh: postgresql+asyncpg://postgres:mypassword@localhost:5432/tomato_leaf
DATABASE_URL=

# ===== Supabase =====
# URL project Supabase (Settings > API > Project URL)
SUPABASE_URL=

# Anon / publishable key. Dipakai untuk client-side & beberapa operasi publik.
# (Settings > API > Project API keys > "anon public")
SUPABASE_KEY=

# Service role key. WAJIB diisi untuk upload gambar dari backend!
# Key ini bypass Row Level Security (RLS) di Storage.
# JANGAN di-expose ke frontend.
# (Settings > API > Project API keys > "service_role")
# Contoh: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
SUPABASE_SERVICE_ROLE_KEY=

# ===== JWT (untuk auth) =====
SECRET_KEY=supersecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
